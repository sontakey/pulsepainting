{
  "name": "pulsepainting",
  "version": "0.2.0",
  "private": true,
  "description": "Your pulse becomes a painting. A camera-based art experience by ChatPPG, powered by ppg-js.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/verify-sketchbook.mjs && node tools/prepare-dist.mjs && tsup",
    "dev": "npm run build && node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "test": "npm run build && npm run test:community-api && npm run test:landscape && npm run test:app && npm run test:camera-guidance && npm run test:paint-fallbacks && npm run test:gallery && npm run test:mobile-gallery && npm run test:community-sharing && npm run test:share-sheet && npm run test:sketchbook && npm run test:personal-sketchbook && npm run test:public-painting-page && npm run test:sketchbook-links && npm run test:public-sketchbook",
    "test:app": "node test/e2e/pulse-painting.mjs",
    "test:camera-guidance": "node test/e2e/camera-guidance.mjs",
    "test:safari-session": "node test/e2e/safari-session.mjs",
    "test:paint-performance": "node test/e2e/paint-performance.mjs",
    "test:paint-fallbacks": "node test/e2e/paint-fallback-checks.mjs",
    "test:qr": "node test/e2e/qr-checks.mjs",
    "test:landscape": "node test/landscape-model.mjs && node test/e2e/landscape-view.mjs && node test/e2e/landscape-parity.mjs --compositor-regression && npm run test:crisp-brush && npm run test:emergence && npm run test:raster-worker",
    "test:raster-worker": "node test/e2e/raster-worker.mjs",
    "test:emergence": "node test/e2e/emerging-landscape.mjs",
    "test:crisp-brush": "node test/e2e/crisp-brush.mjs",
    "test:gallery": "node test/e2e/gallery-checks.mjs",
    "test:mobile-gallery": "node test/e2e/mobile-gallery-checks.mjs",
    "test:community-api": "node test/community-api.mjs",
    "test:community-sharing": "node test/e2e/community-sharing.mjs",
    "test:sketchbook": "node test/e2e/sketchbook-checks.mjs",
    "test:share-sheet": "node test/e2e/share-sheet-checks.mjs",
    "test:personal-sketchbook": "node test/e2e/personal-sketchbook-checks.mjs",
    "test:public-painting-page": "node test/e2e/public-painting-page.mjs",
    "test:sketchbook-links": "node test/e2e/sketchbook-links.mjs",
    "test:public-sketchbook": "node test/e2e/public-sketchbook.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "three": "0.186.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sontakey/pulsepainting.git"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  }
}
